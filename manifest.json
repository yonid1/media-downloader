{
  "manifest_version": 3,
  "name": "מוריד מדיה",
  "short_name": "מוריד מדיה",
  "version": "1.1.0",
  "key": "",
  "description": "מזהה קבצי וידאו ואודיו בעמוד ומוריד אותם בלחיצה, מוריד מיוטיוב דרך yt-dlp ומדלג על פרסומות.",
  "permissions": [
    "downloads",
    "webRequest",
    "storage",
    "contextMenus",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "מוריד מדיה",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
